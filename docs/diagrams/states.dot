digraph States { graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.28",ranksep="0.45",label="Целевая модель состояний (не реализована на сервере)",labelloc=t,fontsize=16,fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",color="#dedee1",fillcolor="#f8f8fa",fontname="DejaVu Sans",fontsize=9]; edge [color="#ed3125",arrowsize=0.65]; Draft[label="Черновик"]; Sent[label="Подана"]; Review[label="На проверке"]; Docs[label="Нужны документы"]; Approved[label="Одобрено"]; Rejected[label="Отказ"]; Alt[label="Другие условия"]; Closed[label="Закрыта"]; Accepted[label="Условия приняты"]; Sign[label="На подписании"]; Signed[label="Подписано"]; Disbursed[label="Выдано (модель)"]; Draft->Sent; Sent->Review; Sent->Approved; Sent->Rejected; Sent->Docs; Docs->Review; Review->Approved;Review->Rejected;Review->Docs;Review->Alt; Alt->Accepted; Alt->Closed; Approved->Accepted;Accepted->Sign->Signed->Disbursed;}