    "description": "Demonstration contract only. Not callable until backend integration."
  },
  "item": [
    {
      "name": "Очередь заявок",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/staff/applications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "staff",
            "applications"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "Карточка заявки",
      "request": {
